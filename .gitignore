# 本地专用的高德 Web 服务密钥（明文）。线上用环境变量，绝不入库
config.local.js

# 依赖目录：由 package.json 重建，体量大且与源码无关，不入库。
# package-lock.json 是要入库的 —— 它才是「装出来的到底是哪一版」的凭据
node_modules/

# 生成器的接口响应缓存：可随时重建，不必入库
tools/.cache/

# 旧的本地 SQLite 库。数据库已于 2026-09-19 迁到 MySQL（见 README 的「数据库」一节），
# 这个文件现在有两个身份：导出 database.sql 的源、以及迁移的回退物 —— 两种情况都要求
# 它保持原样，所以继续挡住。通配 *.db* 是为了把 WAL 模式的附属文件
# app.db-wal / app.db-shm 一起挡住：只写 data/app.db 的话这两个会漏进仓库，
# 而它们连同主库就能还原出全部数据。
data/*.db*

# 数据库导出文件：含 users.password_hash（scrypt 散列，弱口令可离线爆破），
# 所以不入库 —— 它一度进过仓库，2026-09-19 连同历史一起清掉了。
# 它是**生成物**：随时可用 node tools/export-sql.js 重建，源库 data/app.db 一直在。
database.sql

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Vercel 项目关联信息（含 projectId / orgId，属本地绑定）
.vercel

# 会话与工具产物：与站点运行无关，不入库
.playwright-mcp/
.spec-workflow/

# Claude Code 本地配置与日志。若日后要共享权限/技能配置，
# 请单独放行 .claude/settings.json，别整个目录放行
.claude/

# 环境变量文件：即使当前没用 dotenv，也先挡住，免得日后放进来
.env
.env.*
